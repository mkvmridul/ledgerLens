# --- Elasticsearch (Elastic Cloud Serverless project, or local start-local) ---
ES_URL=https://<project-id>.es.<region>.aws.elastic.cloud
ES_API_KEY=<base64 api key>

# --- Kibana (same project; Agent Builder + Workflows + Cases live here) ---
KIBANA_URL=https://<project-id>.kb.<region>.aws.elastic.cloud
KIBANA_API_KEY=<usually the same key as ES_API_KEY>

# --- Agent Builder ---
AGENT_ID=ledgerlens
# LLM selection for the console's converse calls. Leave both empty to use the project's default
# model (Elastic Managed LLM, zero setup). setup:agent prints LLM_INFERENCE_ID when it creates the Bedrock endpoint.
LLM_INFERENCE_ID=
LLM_CONNECTOR_ID=
# "live" talks to the Agent Builder agent. "mock" fills the report template from the same ES|QL tools with no LLM,
# for developing the console. The page shows a red MOCK banner. Never use mock for the demo.
AGENT_MODE=live

# --- Amazon Bedrock (optional; setup:agent creates an Elasticsearch inference endpoint "ledgerlens-bedrock"
#     of task type chat_completion when the two keys are set) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Sarvam AI (optional; enables the Hindi / Kannada report toggle in the console) ---
SARVAM_API_KEY=

# --- Console ---
PORT=3000
DEMO_BUSINESS_DATE=2026-09-16
# "workflow" = approve via the Elastic Workflow tool through the agent (demo default)
# "direct"   = approve via Kibana Cases API from the console server (fallback if Workflows are unavailable)
CASE_MODE=workflow
